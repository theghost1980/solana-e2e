{
  "name": "@solana-e2e/wallet",
  "version": "0.1.0",
  "description": "Wallet Standard test wallet for Solana dApps: mock or real signing, for Playwright and Vitest/jsdom.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "solana",
    "wallet-standard",
    "playwright",
    "vitest",
    "e2e",
    "testing",
    "mock"
  ],
  "peerDependencies": {
    "@solana/kit": "^8.0.0",
    "@playwright/test": ">=1.40"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theghost1980/solana-e2e.git",
    "directory": "packages/wallet"
  },
  "homepage": "https://github.com/theghost1980/solana-e2e/tree/main/packages/wallet#readme",
  "bugs": {
    "url": "https://github.com/theghost1980/solana-e2e/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@solana/wallet-standard-features": "^1.3.0"
  }
}
